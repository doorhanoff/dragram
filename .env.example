DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=myproject

# Пул коннектов к БД. Потолок на процесс = DB_POOL_SIZE + DB_MAX_OVERFLOW.
# При нескольких воркерах умножается на их число и не должен превышать лимит
# соединений вашего провайдера БД.
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30

REDIS_HOST=localhost
REDIS_PORT=6379
# Or set REDIS_URL to connect via a single connection string (takes priority over REDIS_HOST/PORT/PASSWORD)
# REDIS_URL=redis://red-xxxxxxxxxxxxxxxxxxxx:6379

JWT_SECRET_KEY=change-me-to-a-long-random-string

S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
# Отдельный приватный бакет для бэкапов базы (в бакет с медиа их класть нельзя).
S3_BACKUP_BUCKET=your-backup-bucket

# Режим разработки: включает /docs, разрешает CORS с localhost и снимает
# флаг Secure с кук (иначе браузер не отправит их по http://).
# На сервере всегда false.
DEBUG=true
