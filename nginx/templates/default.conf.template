# Шаблон конфига для продакшена. Официальный образ nginx при старте прогоняет
# все /etc/nginx/templates/*.template через envsubst и кладёт результат в
# /etc/nginx/conf.d/ — поэтому ${DOMAIN} и ${S3_BUCKET} подставляются сами.
# Подставляются ТОЛЬКО реально заданные переменные окружения, так что
# внутренние переменные nginx ($host, $remote_addr) остаются нетронутыми.

upstream dragram_app {
    server app:8000;
}

# ── HTTP: только ACME-проверка и редирект на HTTPS ───────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Let's Encrypt кладёт сюда файл-подтверждение при выпуске и продлении.
    # Этот location обязан отвечать по HTTP, поэтому стоит выше редиректа.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS ────────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Максимальный размер загружаемого файла
    client_max_body_size 500M;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    # Без gzip_proxied сжатие не применяется к ответам от upstream —
    # то есть вообще ни к чему, потому что всё приходит от приложения.
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Host $host;

    # На случай, если certbot захочет продлить сертификат, а редирект с :80
    # почему-то не сработал
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Медиа отдаём напрямую из Yandex Object Storage, минуя приложение
    location /media/ {
        proxy_pass https://storage.yandexcloud.net/${S3_BUCKET}/;
        proxy_ssl_server_name on;
        proxy_set_header Host storage.yandexcloud.net;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header Authorization "";
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;
        add_header Cache-Control "public, max-age=604800";
    }

    # Собранный фронтенд: хеши в именах файлов, можно кешировать надолго
    location /assets/ {
        proxy_pass http://dragram_app;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Загрузка файлов в чат — увеличенный таймаут для больших видео
    location ~* ^/chats/[^/]+/upload$ {
        proxy_pass http://dragram_app;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_request_buffering off;
    }

    # WebSocket
    location /chats/ws/ {
        proxy_pass http://dragram_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://dragram_app;
    }
}
