# Шаблон конфига для продакшена. Официальный образ nginx при старте прогоняет
# все /etc/nginx/templates/*.template через envsubst и кладёт результат в
# /etc/nginx/conf.d/ — поэтому ${DOMAIN} подставляется сам.
# Подставляются ТОЛЬКО реально заданные переменные окружения, так что
# внутренние переменные nginx ($host, $remote_addr) остаются нетронутыми.

upstream dragram_app {
    server app:8000;
}

# Лог без query-строки. В обычном combined пишется $request целиком, а в
# query-строке ездят одноразовые тикеты на websocket и медиа — им незачем
# оседать в файле на диске (раньше там оседал сам JWT).
log_format no_args '$remote_addr - $remote_user [$time_local] '
                   '"$request_method $uri $server_protocol" $status '
                   '$body_bytes_sent "$http_referer" "$http_user_agent"';

# ── HTTP: только ACME-проверка и редирект на HTTPS ───────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Let's Encrypt кладёт сюда файл-подтверждение при выпуске и продлении.
    # Этот location обязан отвечать по HTTP, поэтому стоит выше редиректа.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS ────────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    # Набор «intermediate» с ssl-config.mozilla.org вместо расплывчатого
    # HIGH:!aNULL:!MD5 — только AEAD-шифры с forward secrecy.
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # OCSP stapling: браузеру не приходится самому ходить к УЦ за статусом
    # сертификата — быстрее и не «светит» посещение сайта третьей стороне.
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/letsencrypt/live/${DOMAIN}/chain.pem;
    resolver 127.0.0.11 valid=300s;
    resolver_timeout 5s;

    # Максимальный размер загружаемого файла. Согласован с лимитами в
    # src/chats/service.py: 200 МБ на видео — самый большой из них.
    client_max_body_size 200M;

    include /etc/nginx/templates/security-headers.conf;

    gzip on;
    # Без gzip_proxied сжатие не применяется к ответам от upstream —
    # то есть вообще ни к чему, потому что всё приходит от приложения.
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Host $host;

    # На случай, если certbot захочет продлить сертификат, а редирект с :80
    # почему-то не сработал
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        include /etc/nginx/templates/security-headers.conf;
    }

    # Медиа больше НЕ проксируется в бакет напрямую.
    #
    # Раньше здесь стоял proxy_pass на корень бакета — то есть весь бакет
    # раздавался наружу без авторизации, включая префикс backups/ с дампами
    # базы. Теперь запрос идёт в приложение: оно проверяет, что пользователь
    # вошёл, и отвечает редиректом на presigned-ссылку с коротким сроком
    # жизни. Трафик по-прежнему идёт мимо этого сервера — напрямую из
    # хранилища.
    location /media/ {
        proxy_pass http://dragram_app;
        # В query-строке едет медиа-тикет — в лог его не пишем.
        access_log /var/log/nginx/access.log no_args;
        include /etc/nginx/templates/security-headers.conf;
    }

    # Собранный фронтенд: хеши в именах файлов, можно кешировать надолго
    location /assets/ {
        proxy_pass http://dragram_app;
        include /etc/nginx/templates/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Загрузка файлов в чат — увеличенный таймаут для больших видео
    location ~* ^/chats/[^/]+/upload$ {
        proxy_pass http://dragram_app;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_request_buffering off;
        include /etc/nginx/templates/security-headers.conf;
    }

    # WebSocket
    location /chats/ws/ {
        proxy_pass http://dragram_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        # В query-строке едет одноразовый тикет — в лог его не пишем.
        access_log /var/log/nginx/access.log no_args;
        include /etc/nginx/templates/security-headers.conf;
    }

    location / {
        proxy_pass http://dragram_app;
        include /etc/nginx/templates/security-headers.conf;
    }
}
