# Шаблон .env для продакшена. На сервере скопировать в .env и заполнить.
# В git этот файл с настоящими значениями попадать НЕ должен.

# ── Домен и HTTPS ────────────────────────────────────────────────────────
# Домен без https:// и без слеша на конце
DOMAIN=dragram.ru
# Почта для уведомлений Let's Encrypt (если сертификат перестанет продлеваться)
LETSENCRYPT_EMAIL=you@example.com

# Через запятую, полные origin'ы. Домен из DOMAIN добавляется автоматически,
# здесь только дополнительные (например, если фронт живёт отдельно).
# CORS_ORIGINS=https://www.dragram.ru

# ── База данных (Postgres в docker-compose.prod.yaml) ────────────────────
# ВНИМАНИЕ: docker compose раскрывает $ в значениях как подстановку переменной,
# то есть пароль "abc$Odk123" молча превратится в "abc". Если в пароле есть
# знак доллара — удвоить его: abc$$Odk123. Это касается любого значения в
# этом файле. Проверить, что всё прочиталось верно:
#   docker compose -f docker-compose.prod.yaml config | grep DB_PASS
#
# DB_USER: приложению не нужен суперпользователь. Заведите отдельную роль
# (см. DEPLOY.md, раздел «Отдельная роль в Postgres») — тогда SQL-инъекция,
# если она когда-нибудь появится, не даст выполнить COPY ... TO PROGRAM
# и захватить сервер.
# DB_PASS: 32+ случайных символа.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_HOST=db
DB_PORT=5432
DB_USER=dragram
DB_PASS=
DB_NAME=dragram
DB_SSL=false

# Потолок на процесс = DB_POOL_SIZE + DB_MAX_OVERFLOW.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ── Redis ────────────────────────────────────────────────────────────────
# Хост подставляется из docker-compose.prod.yaml (REDIS_HOST=redis).
# Пароль обязателен: изоляции сети Docker мало — любая SSRF в приложении
# иначе даёт полный доступ к состоянию токенов.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────────────
# ВАЖНО: для продакшена сгенерировать новый, не переносить локальный.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# ── Yandex Object Storage ────────────────────────────────────────────────
# Бакет с медиа должен быть ЗАКРЫТЫМ (уровень доступа «Ограниченный»).
# Приложение раздаёт файлы само, через presigned-ссылки: см. src/media/.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Отдельный ПРИВАТНЫЙ бакет для бэкапов базы. Класть их в бакет с медиа
# нельзя: дамп содержит хеши паролей, телефоны и зашифрованные приватные
# ключи пользователей.
S3_BACKUP_BUCKET=
# Отдельный сервисный аккаунт с правами только на бакет бэкапов. Если не
# задан, backup-db.sh возьмёт основные ключи — рабочий, но менее аккуратный
# вариант: один ключ и на загрузку медиа, и на бэкапы.
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=

# Суточная квота на объём загрузок одного пользователя, байт (по умолчанию 1 ГБ).
# UPLOAD_DAILY_QUOTA=1073741824

# ── Push-уведомления (Firebase Cloud Messaging) ──────────────────────────
# Содержимое service-account JSON одной строкой.
FCM_CREDENTIALS_JSON=

# ── Образ приложения ─────────────────────────────────────────────────────
# Собирается через GitHub Actions (.github/workflows/build-image.yml).
APP_IMAGE=ghcr.io/doorhanoff/dragram:latest
