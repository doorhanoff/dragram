# Шаблон .env для продакшена. На сервере скопировать в .env и заполнить.
# В git этот файл с настоящими значениями попадать НЕ должен.

# ── Домен и HTTPS ────────────────────────────────────────────────────────
# Домен без https:// и без слеша на конце
DOMAIN=dragram.ru
# Почта для уведомлений Let's Encrypt (если сертификат перестанет продлеваться)
LETSENCRYPT_EMAIL=you@example.com

# Через запятую, полные origin'ы. Домен из DOMAIN добавляется автоматически,
# здесь только дополнительные (например, если фронт живёт отдельно).
# CORS_ORIGINS=https://www.dragram.ru

# ── База данных (Supabase) ───────────────────────────────────────────────
# ВНИМАНИЕ: docker compose раскрывает $ в значениях как подстановку переменной,
# то есть пароль "abc$Odk123" молча превратится в "abc". Если в пароле есть
# знак доллара — удвоить его: abc$$Odk123. Это касается любого значения в
# этом файле. Проверить, что всё прочиталось верно:
#   docker compose -f docker-compose.prod.yaml config | grep DB_PASS
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=postgres
DB_SSL=true

# Supabase на free-тарифе держит ограниченное число коннектов.
# Потолок на процесс = DB_POOL_SIZE + DB_MAX_OVERFLOW.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ── Redis ────────────────────────────────────────────────────────────────
# Хост подставляется из docker-compose.prod.yaml (REDIS_HOST=redis),
# здесь ничего указывать не нужно.

# ── JWT ──────────────────────────────────────────────────────────────────
# ВАЖНО: для продакшена сгенерировать новый, не переносить локальный.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# ── Yandex Object Storage ────────────────────────────────────────────────
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Push-уведомления (Firebase Cloud Messaging) ──────────────────────────
# Содержимое service-account JSON одной строкой.
FCM_CREDENTIALS_JSON=

# ── Образ приложения ─────────────────────────────────────────────────────
# Собирается через GitHub Actions (.github/workflows/build-image.yml).
APP_IMAGE=ghcr.io/doorhanoff/dragram:latest
